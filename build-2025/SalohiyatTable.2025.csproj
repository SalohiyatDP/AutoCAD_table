<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================================
    AutoCAD 2025 (.NET 8) uchun SalohiyatTable build'i.
    ORIGINAL loyiha (../src/SalohiyatTable.csproj) o'zgartirilmagan — u
    AutoCAD 2018-2024 + Mechanical 2021 (.NET Framework 4.8) uchun ishlaydi.
    Bu loyiha AYNAN SHU manba fayllarni .NET 8 ga qayta kompilyatsiya qiladi.
    Natija: SalohiyatTable_2025.dll  (bundle Contents ichiga qo'yiladi).
    ============================================================================
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>SalohiyatDP.AutoCADTable</RootNamespace>
    <AssemblyName>SalohiyatTable_2025</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>SalohiyatDP</Company>
    <Product>SalohiyatTable</Product>
    <Description>AutoCAD 2025 uchun nuqtalarni raqamlab koordinata/masofa jadvali yasovchi plagin</Description>

    <!-- AutoCAD 2025 o'rnatilgan papka (Ribbon uchun AdWindows.dll shu yerdan olinadi). -->
    <AutoCADPath Condition="'$(AutoCADPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADPath>
  </PropertyGroup>

  <!-- Manba fayllar ../src dan olinadi (obj/bin chiqarib tashlanadi). -->
  <ItemGroup>
    <Compile Include="..\src\**\*.cs" Exclude="..\src\obj\**\*.cs;..\src\bin\**\*.cs" />
  </ItemGroup>

  <!-- AutoCAD 2025 .NET API (net8.0-windows). runtime -> chiqishga nusxalanmaydi. -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="25.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- .NET 8 da System.Management NuGet paketi orqali keladi. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Ribbon menyusi: AdWindows.dll topilsagina qo'shiladi (aks holda build baribir o'tadi). -->
  <PropertyGroup Condition="Exists('$(AutoCADPath)\AdWindows.dll')">
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);RIBBON</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(AutoCADPath)\AdWindows.dll')">
    <Reference Include="AdWindows">
      <HintPath>$(AutoCADPath)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
