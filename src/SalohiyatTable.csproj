<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SalohiyatTable</AssemblyName>
    <RootNamespace>SalohiyatDP.AutoCADTable</RootNamespace>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Platforms>x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <Company>SalohiyatDP</Company>
    <Product>SalohiyatTable</Product>
    <Description>AutoCAD uchun nuqtalarni raqamlab koordinata/masofa jadvali yasovchi plagin</Description>

    <!-- Plaginlar uchun keraksiz papkalarni chiqarmaslik -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!--
      ============================================================
      AutoCAD .NET API versiyasi (NuGet paketi "AutoCAD.NET").
      MUHIM: bu versiya sizdagi AutoCAD versiyasidan KATTA bo'lmasin.
        AutoCAD 2019 -> 23.0.0     AutoCAD 2023 -> 24.2.0
        AutoCAD 2020 -> 23.1.0     AutoCAD 2024 -> 24.3.0
        AutoCAD 2021 -> 24.0.0     AutoCAD 2025 -> 25.0.0 (TargetFramework: net8.0-windows)
        AutoCAD 2022 -> 24.1.0
      ============================================================
    -->
    <AcadNetVersion Condition="'$(AcadNetVersion)' == ''">24.0.0</AcadNetVersion>

    <!--
      ============================================================
      LENTADAGI MENYU (Ribbon) uchun AutoCAD o'rnatilgan papka.
      AdWindows.dll NuGet'da yo'q, u faqat AutoCAD papkasida bo'ladi.
      Bu yerga o'z AutoCAD papkangizni yozing, masalan:
        C:\Program Files\Autodesk\AutoCAD 2022
      Agar to'g'ri ko'rsatilsa -> "SalohiyatTable" lenta menyusi paydo bo'ladi.
      Agar bo'sh/noto'g'ri bo'lsa -> build baribir muvaffaqiyatli bo'ladi,
      lekin menyu bo'lmaydi (faqat PTABLE / PLTABLE buyruqlari ishlaydi).
      ============================================================
    -->
    <AutoCADPath Condition="'$(AutoCADPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2021</AutoCADPath>
  </PropertyGroup>

  <!-- Asosiy AutoCAD .NET API (NuGet). runtime -> chiqishga nusxalanmaydi. -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="$(AcadNetVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Litsenziya moduli uchun: Machine ID (CPU/BIOS) WMI orqali olinadi. -->
  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

  <!--
    Ribbon menyusi: AdWindows.dll topilgan taqdirdagina qo'shiladi.
    Shu tufayli AutoCADPath noto'g'ri bo'lsa ham loyiha baribir kompilyatsiya bo'ladi.
  -->
  <PropertyGroup Condition="Exists('$(AutoCADPath)\AdWindows.dll')">
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);RIBBON</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(AutoCADPath)\AdWindows.dll')">
    <Reference Include="AdWindows">
      <HintPath>$(AutoCADPath)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
